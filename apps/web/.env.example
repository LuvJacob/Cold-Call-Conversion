# Placeholders only. Copy to .env.local for local development.
# "demo" (default): offline sample data in the browser. "api": use the FastAPI backend.
NEXT_PUBLIC_DATA_MODE=demo
# Where the server-side proxy (/api/*) reaches the backend.
API_BASE_URL=http://127.0.0.1:8000
# Dev-auth seller id sent by the proxy as X-Seller-ID (AUTH_MODE=dev only).
DEMO_SELLER_ID=demo-seller
