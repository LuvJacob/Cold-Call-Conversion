# Copy to .env (never commit it) or set these in the research worker's environment.
# All values are empty placeholders. A missing key falls back to the free public sources.

# Which LLM writes summaries and talking points: watsonx (default) or gemini
LLM_PROVIDER=

# Tavily web search
TAVILY_API_KEY=

# People Data Labs person/company enrichment
PDL_API_KEY=
# Minimum match likelihood 1-10 (default 6); weaker matches count as no match
PDL_MIN_LIKELIHOOD=

# IBM watsonx.ai
WATSONX_API_KEY=
# Region base URL, for example https://us-south.ml.cloud.ibm.com
WATSONX_URL=
WATSONX_PROJECT_ID=
# Optional. Default: ibm/granite-3-3-8b-instruct
WATSONX_MODEL_ID=
# Optional. API version date. Default: 2024-05-31
WATSONX_API_VERSION=

# Google Gemini (used when LLM_PROVIDER=gemini)
GEMINI_API_KEY=
# Optional. Default: gemini-flash-lite-latest
GEMINI_MODEL=

# Free sources (optional, see README)
SEC_USER_AGENT=
RESEARCH_CONTACT=
