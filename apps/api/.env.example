# Copy to .env (never commit it) or set these in the API/worker environment.
# All values are empty placeholders; never put real keys in this file.

# Research mode: empty (sample fixtures only), free, or live (spends paid credits)
RESEARCH_PROVIDERS=
# Total attempts per research job; retries can repeat paid calls in live mode
RESEARCH_MAX_ATTEMPTS=

# Live mode providers (a missing key falls back to free sources or template text)
LLM_PROVIDER=
TAVILY_API_KEY=
PDL_API_KEY=
PDL_MIN_LIKELIHOOD=
WATSONX_API_KEY=
WATSONX_URL=
WATSONX_PROJECT_ID=
WATSONX_MODEL_ID=
WATSONX_API_VERSION=
GEMINI_API_KEY=
GEMINI_MODEL=

# Free sources
SEC_USER_AGENT=
RESEARCH_CONTACT=
