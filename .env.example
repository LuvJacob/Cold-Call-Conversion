# Copy to .env (git-ignored) and replace the placeholders. NEVER commit .env.
# Use letters and digits only in the password: it is placed inside a MongoDB URI.
# Generate one:  python3 -c "import secrets; print(secrets.token_hex(24))"

MONGO_ROOT_USERNAME=appadmin
MONGO_ROOT_PASSWORD=replace-with-a-long-random-value
MONGODB_DB_NAME=cold_call_conversion

# Used only by the MONGO_URL-gated tests (see apps/api/README.md). Placeholder values.
# MONGO_URL=mongodb://appadmin:replace-with-a-long-random-value@127.0.0.1:27017/?authSource=admin

# Research mode for the API: free (default: real Wikidata / SEC EDGAR / company-site lookups, no keys),
# live (paid providers, keys below), or empty (offline sample fixtures only).
RESEARCH_PROVIDERS=free
# SEC requires a descriptive User-Agent with contact info; unset skips SEC EDGAR. Placeholder, use your own.
SEC_USER_AGENT="ColdCallConversion research contact@example.com"
# Optional contact text appended to the User-Agent for Wikimedia and company sites. Placeholder, use your own.
RESEARCH_CONTACT="contact@example.com"
